{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cashflow.py": {
      "runtime": "@vercel/python@4.3.1",
      "includeFiles": "../src/openval/**"
    },
    "api/parse_workbook.py": {
      "runtime": "@vercel/python@4.3.1",
      "includeFiles": "../src/openval/**"
    },
    "api/export_workbook.py": {
      "runtime": "@vercel/python@4.3.1",
      "includeFiles": "../src/openval/**"
    }
  },
  "rewrites": [
    { "source": "/api/cashflow", "destination": "/api/cashflow.py" },
    { "source": "/api/parse_workbook", "destination": "/api/parse_workbook.py" },
    { "source": "/api/export_workbook", "destination": "/api/export_workbook.py" }
  ]
}
